# whisper-obsidian configuration
# Copy to ~/.config/local-whisper-obsidian/.env and edit

# Path to the repository's src directory.
# make install sets this automatically; set it manually if you edit the config later.
# WHISPER_SRC=$HOME/projects/local-whisper-obsidian/src

# Path to Python venv (created by make install)
WHISPER_ENV=$HOME/.local/share/local-whisper-obsidian/venv

# Whisper model: tiny | base | small | medium | large-v3
# Recommendation: small = best balance for CPU
MODEL=small

# Language: auto | en | de | uk | ru | fr
# auto = automatic detection (slightly slower)
LANGUAGE=auto

# Watch paths separated by colon (:)
# Add as many directories as needed
SCAN_PATHS=$HOME/obsidian-vault/0_inbox/assets:$HOME/obsidian-vault/1_journal/assets
